  "reviewFindings": [
    {
      "kind": "source finding independently raised, then actually reproduced",
      "issue": "Deferred failure from cancelled capture A could call unqualified adapter cleanup and clear replacement B.",
      "preFix": {
        "tests": 2,
        "pass": 0,
        "fail": 2,
        "raw": "docs/pathfinder/evidence/batched-capture/adapter-stale-owner-before-fix-1792340200.tap"
      },
      "fix": "Both asynchronous adapter catches cancel only when their captured state still owns capture. Tests defer both SDK and digest work, start B, deliver A late, then prove B accepts all chunks and begins metadata output."
    },
    {
      "kind": "source finding independently raised, then actually reproduced",
      "issue": "Initial authorization elapsed before adapter timer start, and final postauthorization could outlive completed adapter timer, exceeding the common 300s budget.",
      "preFix": {
        "tests": 2,
        "pass": 0,
        "fail": 2,
        "raw": "docs/pathfinder/evidence/batched-capture/bridge-deadline-before-fix-1792340400.tap"
      },
      "fix": "Bridge creates a private capture deadline and timer before initial START authorization; all capture rounds share it through final authorized emit. Timeout abort/discard and cleanup are scope-owned. Adapter receives the original startedAt and uses only its remaining budget. Synthetic Date controls defer initial and final authorization beyond300s and prove no late SDK start or terminal success."
    }
  ],
