<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>Exe</OutputType><AssemblyName>Wfc.PathFinder.NativeOracle.Runner</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x64</PlatformTarget><LangVersion>7.3</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath><IntermediateOutputPath>obj\Runner\$(Configuration)\</IntermediateOutputPath>
    <Optimize>true</Optimize><Deterministic>true</Deterministic><WarningLevel>4</WarningLevel>
    <NavisworksInstallDir Condition="'$(NavisworksInstallDir)' == ''">D:\Programs\Navisworks Manage 2027</NavisworksInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api"><HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Api.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Autodesk.Navisworks.Automation"><HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Automation.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Compile Include="Runner.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
