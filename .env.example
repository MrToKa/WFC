# Copy this file to .env or run: powershell -ExecutionPolicy Bypass -File .\scripts\setup-wfc.ps1

COMPOSE_PROJECT_NAME=wfc

# Container images
POSTGRES_IMAGE=postgres:18
MINIO_IMAGE=minio/minio:latest

# PostgreSQL (use URL-safe characters for POSTGRES_PASSWORD)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_RANDOM_PASSWORD
POSTGRES_DB=wfc_app
POSTGRES_HOST_PORT=5434

# MinIO
MINIO_ROOT_USER=wfcminio
MINIO_ROOT_PASSWORD=CHANGE_ME_WITH_A_RANDOM_PASSWORD
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_BUCKET_PROJECTS=wfc-project-files
MINIO_BUCKET_TEMPLATES=wfc-template-files
MINIO_URL_EXPIRY_SECONDS=900

# WFC application
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
WFC_HTTP_PORT=5173
BCRYPT_ROUNDS=12

# Same-origin access through the web container needs no CORS exception.
# Use a comma-separated list only when another frontend calls the API directly.
CLIENT_ORIGIN=true

# Private offline model registry and Viewer. Exact origins include the public port.
WFC_MODEL_BUCKET=wfc-models
WFC_VIEWER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WFC_VIEWER_ALLOW_HTTP_LOOPBACK=true
# Enable only when the API is private behind the configured reverse proxy.
WFC_VIEWER_TRUST_PROXY=true
# Development /api proxy; the browser still uses the frontend origin.
WFC_API_PROXY_TARGET=http://127.0.0.1:4000
# Diagnostic harness is opt-in; final project UI belongs to later stages.
VITE_VIEWER_HARNESS=false

